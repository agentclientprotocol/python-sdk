[info]
title=AI Agents
desc=Connect to AI coding agents via the Agent Client Protocol (ACP). Supports Gemini CLI, Qwen CLI, OpenCode, Claude Code, and other ACP-compatible agents. Agents can help with coding, debugging, refactoring, and other development tasks. Some agents offer generous free usage like Gemini and Qwen.
type=cudatext-plugin
subdir=cuda_ai_agents
homepage=


